# Local environment

Copy this file to `.env.local`. Leave values empty to run the local demo. Do not put real emails, API keys, or tokens in this file or anywhere else in the repository.

# Public site URL, used for auth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase. Use the project URL, the anon or publishable key, and the service role or secret key.
# All three must be set or the app stays in local demo mode.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated admin allowlist for Kony and Sisay. Placeholders only.
# Example, not a real inbox: studio.admin@example.com
# Leave empty to run with no admins.
ADMIN_EMAILS=

# Google OAuth. Leave empty until a Cloud project exists. See GOOGLE_SETUP.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/admin/google/callback

# Optional. Created after the consent screen. Never commit a real token.
GOOGLE_REFRESH_TOKEN=

# Optional. Set this before exposing demo mode beyond your own machine.
# DEMO_SESSION_SECRET=
